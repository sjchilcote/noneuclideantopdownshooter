 "lore": {
  "intro": "The Core. The Container is here.\nIt was here before the station.\nThe station grew around it, like scar tissue.\n\nRatio is quiet for the first time.",
  "radio": [
   {
    "trigger": "start",
    "text": "Ratio: ...I'll say this once, and then we work. If it offers you an ending \u2014 any ending \u2014 the offer is the weapon. Guard the door. That's all we are now."
   },
   {
    "trigger": "enter_room:4",
    "text": "Ratio: The seal answers the void key. Last door, Commando."
   },
   {
    "trigger": "pickup:void",
    "text": "Ratio: The void seal. It was waiting in the far coset. It WANTS to be found, Commando. Remember that at the door."
   },
   {
    "trigger": "kills:20",
    "text": "Ratio: The Warden is the door's idea of a guard. Show it a better one."
   },
   {
    "trigger": "exit",
    "text": "Ratio: It's quiet. It'll stay quiet a thousand years, as long as someone stands here.\nLucky for the universe, I know a guy.\nSunward, Commando. We'll take the watch together."
   }
  ],
  "terminals": [
   {
    "room": 2,
    "pos": [
     760.0,
     59.99999999999999
    ],
    "text": "CONTAINMENT PROTOCOL, FINAL REVISION\n1. Do not open the Container.\n2. There is no rule two.\n\nThe Container does not hold the anomaly.\nThe Container is how the anomaly holds US."
   },
   {
    "room": 7,
    "pos": [
     1600,
     290
    ],
    "text": "[The Container does not speak in words.\nIt rearranges the room until the room\nis a sentence.\nThe sentence is an offer.]\n\nGUARD / ACCEPT / KNEEL / BURN\n\n[You think of Ratio. You guard.]"
   }
  ]
 },
 "alert_hops": 1
