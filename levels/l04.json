 "lore": {
  "intro": "The Long Gallery. Two service corridors,\nfour crossings. Everyone agrees on that.\nEveryone who walked it southside.",
  "radio": [
   {
    "trigger": "start",
    "text": "Ratio: Gallery run. South corridor to the far end, come back along the north."
   },
   {
    "trigger": "enter_room:2",
    "text": "Ratio: North side. Count the crossings for me, would you? I have four on file."
   },
   {
    "trigger": "enter_room:3",
    "text": "Ratio: Crossing one. There's a blue seal in there \u2014 which is strange, because from the north wall, there is no crossing one."
   },
   {
    "trigger": "pickup:blue",
    "text": "Ratio: Blue seal. The vault. Commando \u2014 the notes say what's in there isn't ours."
   },
   {
    "trigger": "exit",
    "text": "Ratio: Your arm. Is it\u2014 okay. We'll call it equipment. Equipment doesn't hum, but we'll call it that."
   }
  ],
  "terminals": [
   {
    "room": 1,
    "pos": [
     700,
     255
    ],
    "text": "GRAFFITI, scratched into the panel:\n4 GOING  3 BACK\n4 GOING  3 BACK\n4 GOING  3 BACK\nover and over, forty times."
   },
   {
    "room": 7,
    "pos": [
     380,
     430
    ],
    "text": "MEDICAL BAY (RELOCATED)\nPatient: unnamed, found in Gallery.\nImplant of unknown design fused to left arm.\nPatient states the implant 'came through the wall.'\nPatient discharged. Implant retained. Vault, blue seal."
   }
  ]
 }
